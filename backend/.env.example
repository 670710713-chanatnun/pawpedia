# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# Supabase → Project Settings → Database → Connection string → "Session pooler"
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# อย่างน้อย 32 ตัวอักษร
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# คั่นด้วย , (ใส่ URL ของ Vercel ตอน deploy)
ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
# บัญชี admin ที่จะถูกสร้างให้อัตโนมัติตอนเริ่ม server
ADMIN_EMAIL=admin@pawpedia.dev
ADMIN_PASSWORD=change-me-admin-password
